{
  "name": "ai-job-matcher",
  "version": "1.0.0",
  "description": "AI-Powered Resume-Based Job Search and Aggregation Web Application",
  "main": "index.js",
  "scripts": {
    "start:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start:frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "install:frontend": "cd frontend && npm install",
    "install": "npm run install:backend && npm run install:frontend",
    "test": "cd backend && pytest"
  },
  "keywords": [
    "ai",
    "job-search",
    "resume-parser",
    "job-matching"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.548.0"
  }
}
